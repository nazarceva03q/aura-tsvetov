# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в git не коммитится (см. .gitignore) — храните секреты только на сервере.

# Токен бота из настроек бота в Max (Мастер ботов). Уже создан: см. README.md.
MAX_BOT_TOKEN=

# chat_id / user_id Олеси в Max. Бот не может писать первым — Олеся должна
# сама нажать «Начать» в чате с ботом хотя бы один раз, после чего её user_id
# появится в логах сервера (см. README.md, шаг «Узнать chat_id Олеси»).
# Это же значение — единственный адрес, куда уходят заявки/вопросы покупателей.
MAX_OWNER_CHAT_ID=

# Необязательно: ещё чьи-то user_id (через запятую), у которых тоже будет
# доступ к меню управления магазином (Добавить/Изменить/Удалить товар,
# Заявки) — например, разработчика, проверяющего, что всё работает. Заявки
# покупателей им НЕ дублируются — это только для MAX_OWNER_CHAT_ID выше.
# Как узнать свой user_id — тем же способом, что и для Олеси (см. README.md).
MAX_ADMIN_CHAT_IDS=

# Секрет для проверки заголовка X-Max-Bot-Api-Secret на входящих вебхуках
# от Max (защита от поддельных запросов). Придумайте любую случайную строку
# (буквы, цифры, дефис, 5-256 символов) и используйте то же значение при
# регистрации вебхука (npm run setup-webhook).
MAX_WEBHOOK_SECRET=

# Публичный адрес сайта (без слэша на конце) — используется для CORS
# (разрешить сайту слать заявки на /webhook/lead) и для сборки site_ref,
# если он не пришёл с сайта явно.
SITE_BASE_URL=https://aura-flower.shop

# Порт, на котором слушает сервер бота.
PORT=3000

# ПОЛНЫЙ HTTPS-адрес вебхука (без слэша на конце) — нужен только для
# скрипта npm run setup-webhook, который регистрирует вебхук в Max.
#   VM (server.js):        https://bot.aura-flower.shop/webhook/max
#   Yandex Cloud Functions: https://functions.yandexcloud.net/<id-функции>
PUBLIC_SERVER_URL=

# --- Нужно ТОЛЬКО для деплоя на Yandex Cloud Functions ---
# Там нет постоянного диска между вызовами функции, поэтому сессии диалога,
# список клиентов и вопросы хранятся в Yandex Object Storage вместо
# локальных файлов (bot/data/*.json). Если разворачиваете на обычной VM —
# оставьте эти три поля пустыми, бот сам будет использовать локальные файлы.
# Как получить — см. bot/README.md, раздел «Yandex Object Storage».
YC_S3_BUCKET=
YC_S3_ACCESS_KEY=
YC_S3_SECRET_KEY=

# --- Нужно для управления каталогом из бота (Добавить/Изменить/Удалить товар) ---
# ОТДЕЛЬНЫЙ, ПУБЛИЧНЫЙ (открытый на чтение) бакет — здесь лежит catalog.json
# и фото товаров, добавленные владелицей через бота. Сайт читает его
# напрямую по HTTPS, без обращения к функции бота. Ключи доступа — те же,
# что выше (один сервисный аккаунт может писать в оба бакета). См.
# bot/README.md, раздел «Публичный бакет для каталога».
YC_PUBLIC_S3_BUCKET=
